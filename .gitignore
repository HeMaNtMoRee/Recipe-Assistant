# ─── Python ───────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so

# ─── Virtual Environments ────────────────────────────────────────────
.env
.venv/
venv/
env/
ENV/

# ─── Distribution / Packaging ────────────────────────────────────────
build/
dist/
*.egg-info/
*.egg

# ─── Runtime Databases (auto-created by the app) ─────────────────────
# SQLite DB – created by SQLAlchemy on startup (database.py → init_db)
*.db
*.db-journal
*.sqlite3
*.sqlite3-journal

# ChromaDB – created by PersistentClient on first use (vector_db.py)
chroma_data/

# ─── IDE / Editor ────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ─── OS Files ────────────────────────────────────────────────────────
desktop.ini
ehthumbs.db

# ─── Logs ─────────────────────────────────────────────────────────────
*.log

# ─── Misc ─────────────────────────────────────────────────────────────
.cache/
.ruff_cache/
.mypy_cache/
.pytest_cache/
